                </property>
                <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT CAST(P.ProductoID AS int)                      AS ProductoID,
       CAST(LTRIM(RTRIM(P.Producto)) AS varchar(100))  AS NombreProducto,
       CAST(P.ProveedorID AS int)                      AS ProveedorID,
       CAST(P.CategoriaID AS int)                      AS CategoriaID,
       CAST(LTRIM(RTRIM(C.Categoria)) AS varchar(50))  AS NombreCategoria
FROM dbo.Productos AS P
INNER JOIN dbo.Categorias AS C
        ON C.CategoriaID = P.CategoriaID;</property>
