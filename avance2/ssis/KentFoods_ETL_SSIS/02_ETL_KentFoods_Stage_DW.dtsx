    <DTS:Executable DTS:refId="Package\12_SQL_Actualizar_Envios_Pendientes" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Completa fecha de envío, días y transportista en los hechos que estaban pendientes de despacho" DTS:DTSID="{AE14F19A-4603-412F-A344-E0FF9D2736E7}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="12_SQL_Actualizar_Envios_Pendientes" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{CC60D47F-1ADF-49D3-A259-74863CF2F56D}" SQLTask:SqlStatementSource="UPDATE F&#xA;SET F.id_fecha_envio   = CAST(CONVERT(char(8), O.FechaEnvio, 112) AS int),&#xA;    F.dias_envio       = DATEDIFF(DAY, O.FechaOrden, O.FechaEnvio),&#xA;    F.id_transportista = O.TransportistaID&#xA;FROM dbo.Fact_Ventas AS F&#xA;INNER JOIN KentFoods_STAGE.dbo.ST_ORDEN AS O ON O.OrdenID = F.id_orden&#xA;WHERE F.id_fecha_envio IS NULL&#xA;  AND O.FechaEnvio IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
