    <DTS:Executable DTS:refId="Package\02_SQL_Actualizar_Dim_Transportista" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Actualiza los transportistas existentes cuyo nombre cambió" DTS:DTSID="{F6F47CDE-AAFF-4BBF-BCEE-7EC3F7DB94EC}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="02_SQL_Actualizar_Dim_Transportista" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{CC60D47F-1ADF-49D3-A259-74863CF2F56D}" SQLTask:SqlStatementSource="UPDATE D SET D.Transportista = S.Transportista&#xA;FROM dbo.Dim_Transportista AS D&#xA;INNER JOIN KentFoods_STAGE.dbo.ST_TRANSPORTISTA AS S ON S.TransportistaID = D.TransportistaID&#xA;WHERE EXISTS (SELECT S.Transportista EXCEPT SELECT D.Transportista);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\03_DFT_Dim_Transportista_Nuevos" DTS:CreationName="Microsoft.Pipeline" DTS:Description="ST_TRANSPORTISTA -&gt; Dim_Transportista (solo transportistas nuevos)" DTS:DTSID="{0B4B970E-E585-4CCE-91BF-943A27EDA147}" DTS:ExecutableType="Microsoft.Pipeline" DTS:LocaleID="-1" DTS:ObjectName="03_DFT_Dim_Transportista_Nuevos" DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
