                <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT S.ClienteCodigo, S.NombreEmpresa, S.Ciudad, S.CodigoPostal, S.Pais
