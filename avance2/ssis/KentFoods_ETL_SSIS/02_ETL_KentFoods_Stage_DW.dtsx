        <SQLTask:SqlTaskData SQLTask:Connection="{CC60D47F-1ADF-49D3-A259-74863CF2F56D}" SQLTask:SqlStatementSource="UPDATE D SET D.NombreEmpleado = S.NombreEmpleado, D.Territorio = S.Territorio, D.Region = S.Region&#xA;FROM dbo.Dim_Empleado AS D&#xA;INNER JOIN KentFoods_STAGE.dbo.ST_EMPLEADO AS S ON S.EmpleadoID = D.EmpleadoID&#xA;WHERE EXISTS (SELECT S.NombreEmpleado, S.Territorio, S.Region EXCEPT SELECT D.NombreEmpleado, D.Territorio, D.Region);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
