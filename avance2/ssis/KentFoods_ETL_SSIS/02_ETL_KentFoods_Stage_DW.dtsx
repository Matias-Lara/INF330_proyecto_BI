    <DTS:Executable DTS:refId="Package\04_SQL_Actualizar_Dim_Proveedor" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Actualiza los proveedores existentes cuyos atributos cambiaron" DTS:DTSID="{FE1B78E7-8252-4F24-8FC6-CC94F4B7D5BD}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="04_SQL_Actualizar_Dim_Proveedor" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{CC60D47F-1ADF-49D3-A259-74863CF2F56D}" SQLTask:SqlStatementSource="UPDATE D SET D.Proveedor = S.Proveedor, D.Ciudad = S.Ciudad, D.Pais = S.Pais&#xA;FROM dbo.Dim_Proveedor AS D&#xA;INNER JOIN KentFoods_STAGE.dbo.ST_PROVEEDOR AS S ON S.ProveedorID = D.ProveedorID&#xA;WHERE EXISTS (SELECT S.Proveedor, S.Ciudad, S.Pais EXCEPT SELECT D.Proveedor, D.Ciudad, D.Pais);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
